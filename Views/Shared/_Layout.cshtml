<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IUBAT Campus Services</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ===== NDC Top Toolbar ===== -->
    <div class="rs-toolbar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7 col-md-6">
                    <div class="rs-toolbar-left">
                        <div class="welcome-message">
                            <i class="fa fa-university"></i>
                            <span>Welcome to IUBAT — International University of Business Agriculture and Technology</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5 col-md-6">
                    <div class="rs-toolbar-right">
                        <div class="toolbar-share-icon">
                            <ul>
                                <li><a href="https://www.facebook.com" target="_blank" aria-label="Facebook"><i class="fa fa-facebook"></i></a></li>
                                <li><a href="https://twitter.com" target="_blank" aria-label="Twitter"><i class="fa fa-twitter"></i></a></li>
                                <li><a href="https://www.youtube.com" target="_blank" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a></li>
                                <li><a href="https://www.linkedin.com" target="_blank" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a></li>
                            </ul>
                        </div>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <a class="apply-btn" asp-controller="Account" asp-action="Logout" style="pointer-events:none; opacity:0.92;">
                                <i class="fa fa-user"></i> @User.Identity.Name
                            </a>
                        }
                        else
                        {
                            <a class="apply-btn" asp-controller="Account" asp-action="Login"><i class="fa fa-sign-in"></i> Apply / Login</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Header Top: Logo + Contact Widgets ===== -->
    <div class="rs-header-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-4 col-md-12">
                    <div class="logo-area">
                        <a asp-controller="Home" asp-action="Index">
                            <span class="logo-img">I</span>
                            <span class="logo-text">
                                <span class="brand-title">IUBAT</span>
                                <span class="brand-subtitle">Campus Services</span>
                                <span class="brand-tagline">Student Service Request System</span>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="col-lg-8 d-none d-lg-block">
                    <div class="row g-0">
                        <div class="col-sm-4">
                            <div class="header-contact">
                                <div class="widget-text">
                                    <i class="fa fa-envelope-o"></i>
                                    <div class="info-text">
                                        <span>Mail Us</span>
                                        <a href="mailto:info@iubat.edu">info@iubat.edu</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="header-contact">
                                <div class="widget-text">
                                    <i class="fa fa-phone"></i>
                                    <div class="info-text">
                                        <span>Call Us</span>
                                        <a href="tel:+8809613933933">+88 09613-933933</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="header-contact">
                                <div class="widget-text">
                                    <i class="fa fa-map-marker"></i>
                                    <div class="info-text">
                                        <span>Location</span>
                                        <span class="info-link" style="font-size:13px;">Uttara, Dhaka-1230</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===== Navy Menu Bar (Sticky) ===== -->
    <div class="menu-area menu-sticky" id="mainMenu">
        <div class="container">
            <nav class="navbar navbar-expand-lg navbar-custom">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="fa fa-home" style="margin-right:6px; color:var(--accent);"></i> Home</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">About</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#">At a Glance</a></li>
                                <li><a class="dropdown-item" href="#">Our History</a></li>
                                <li><a class="dropdown-item" href="#">Why Study at IUBAT</a></li>
                                <li><a class="dropdown-item" href="#">Infrastructure</a></li>
                            </ul>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Student"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Create">Submit Request</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="MyRequests">My Requests</a></li>
                            }
                            @if (User.IsInRole("Staff"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Staff" asp-action="AllRequests">All Requests</a></li>
                            }
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false">Academic</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="#">Code of Conduct</a></li>
                                    <li><a class="dropdown-item" href="#">Guideline for Parents</a></li>
                                    <li><a class="dropdown-item" href="#">Dress Code</a></li>
                                </ul>
                            </li>
                            <li class="nav-item"><a class="nav-link" href="#">Admission</a></li>
                        }
                        <li class="nav-item"><a class="nav-link" href="#">Notice</a></li>
                        <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item d-none d-lg-flex align-items-center me-2">
                            <a class="nav-link search-icon" href="#" title="Search" onclick="return false;"><i class="fa fa-search"></i></a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-link user-pill" style="cursor:default;">
                                    <i class="fa fa-user-circle" style="color:var(--accent);"></i> @User.Identity.Name
                                    @if (User.IsInRole("Staff")){ <span class="badge-staff">Staff</span> }
                                    else{ <span class="badge-student">Student</span> }
                                </span>
                            </li>
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm" style="background:var(--accent); color:#fff; border:none; padding:7px 14px; border-radius:4px; font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:0.05em;">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login" style="font-weight:700;"><i class="fa fa-sign-in" style="color:var(--accent);"></i> Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register" style="background:rgba(255,255,255,0.12); border-radius:4px; margin-left:6px; padding:8px 14px!important; border:1px solid rgba(255,255,255,0.18);"><i class="fa fa-user-plus" style="color:var(--accent);"></i> Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </nav>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    <!-- ===== Footer (NDC style) ===== -->
    <footer id="rs-footer" class="rs-footer">
        <div class="footer-top">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-3 col-md-6">
                        <div class="footer-logo">
                            <div class="footer-logo-icon">I</div>
                            <div class="footer-logo-text">
                                <strong>IUBAT</strong>
                                <span>Campus Services Portal</span>
                            </div>
                        </div>
                        <p class="footer-desc">
                            IUBAT Campus Services is a streamlined platform for ID card, transcript and certificate requests — transparent, secure and always available for students and staff.
                        </p>
                        <div class="footer-share">
                            <a href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
                            <a href="#" aria-label="Twitter"><i class="fa fa-twitter"></i></a>
                            <a href="#" aria-label="YouTube"><i class="fa fa-youtube-play"></i></a>
                            <a href="#" aria-label="LinkedIn"><i class="fa fa-linkedin"></i></a>
                            <a href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h4 class="footer-title">Our Sitemap</h4>
                        <ul class="sitemap-widget">
                            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a href="#">About IUBAT</a></li>
                            <li><a href="#">Admission Information</a></li>
                            <li><a asp-controller="Student" asp-action="Create">Submit Request</a></li>
                            <li><a asp-controller="Student" asp-action="MyRequests">My Requests</a></li>
                            <li><a asp-controller="Staff" asp-action="AllRequests">Staff Dashboard</a></li>
                            <li><a asp-controller="Account" asp-action="Login">Login</a></li>
                            <li><a asp-controller="Account" asp-action="Register">Register</a></li>
                        </ul>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h4 class="footer-title">Recent Services</h4>
                        <div class="recent-post-widget">
                            <div class="post-item">
                                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=200&q=60" alt=""></div>
                                <div>
                                    <div class="post-title"><a href="#">ID Card Replacement — Fast Track Processing</a></div>
                                    <div class="post-date"><i class="fa fa-clock-o"></i> 24h turnaround</div>
                                </div>
                            </div>
                            <div class="post-item">
                                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=200&q=60" alt=""></div>
                                <div>
                                    <div class="post-title"><a href="#">Academic Transcript Request Portal</a></div>
                                    <div class="post-date"><i class="fa fa-check-circle"></i> Digital + Print</div>
                                </div>
                            </div>
                            <div class="post-item">
                                <div class="post-thumb"><img src="https://images.unsplash.com/photo-1498243691581-b145c3f54a5a?auto=format&fit=crop&w=200&q=60" alt=""></div>
                                <div>
                                    <div class="post-title"><a href="#">Certificate & Verification Services</a></div>
                                    <div class="post-date"><i class="fa fa-shield"></i> Staff verified</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <h4 class="footer-title">Contact & Info</h4>
                        <div class="footer-contact-desc">
                            <div class="contact-inner">
                                <i class="fa fa-map-marker"></i>
                                <div class="info">
                                    <span>Address</span>
                                    <div>4 Embankment Drive Road, Sector-10, Uttara Model Town, Dhaka-1230</div>
                                </div>
                            </div>
                            <div class="contact-inner">
                                <i class="fa fa-phone"></i>
                                <div class="info">
                                    <span>Phone</span>
                                    <a href="tel:+8809613933933">+88 09613-933933</a>
                                </div>
                            </div>
                            <div class="contact-inner">
                                <i class="fa fa-envelope"></i>
                                <div class="info">
                                    <span>Email</span>
                                    <a href="mailto:info@iubat.edu">info@iubat.edu</a>
                                </div>
                            </div>
                        </div>
                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary-custom btn-sm" style="flex:1; justify-content:center;"><i class="fa fa-user-plus"></i> Join Now</a>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-custom btn-sm" style="flex:1; justify-content:center; background:#fff;"><i class="fa fa-sign-in"></i> Sign In</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <div class="copyright">
                    <div>&copy; 2026 International University of Business Agriculture and Technology — <span style="color:#fff; font-weight:700;">IUBAT Campus Services</span>. All Rights Reserved.</div>
                    <ul class="footer-links d-none d-md-flex">
                        <li><a href="#">Privacy</a></li>
                        <li><a href="#">Terms</a></li>
                        <li><a href="#">Help Desk</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Sticky menu like NDC
        (function(){
            var menu = document.getElementById('mainMenu');
            if(!menu) return;
            var offset = menu.offsetTop;
            window.addEventListener('scroll', function(){
                if(window.scrollY > offset + 120){
                    menu.classList.add('sticky');
                } else {
                    menu.classList.remove('sticky');
                }
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
